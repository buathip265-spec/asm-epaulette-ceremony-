rules_version = '2';

// ============================================================================
// Firestore Security Rules — Epaulette Ceremony Check-In System
//
// Roles are stored as data, not custom claims, in staffUsers/{uid}.role
// ('staff' | 'admin'). This keeps role management a normal Firestore write
// an admin can make, with no Cloud Functions / Admin SDK required.
//
// Document-ID strategy: participants are keyed by studentId when one exists
// (falls back to a generated id for guests with none). This is what lets
// PUBLIC do a single-document `get()` lookup by student ID without ever
// being able to `list`/enumerate the roster — Firestore treats get() and
// list() as separate operations, and only get() is opened to the public.
//
// Collection name: the participant collection is called "guests" (kept as
// the pre-existing name — the app talks about "participants" in its UI and
// code, but the underlying Firestore collection was deliberately not
// renamed, to avoid an unforced migration).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- role helpers -------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // If the caller has no staffUsers document, this errors internally and
    // the containing boolean short-circuits to false — i.e. "no role doc"
    // fails closed as PUBLIC, never as STAFF/ADMIN.
    function role() {
      return get(/databases/$(database)/documents/staffUsers/$(request.auth.uid)).data.role;
    }
    function isStaff() {
      return isSignedIn() && role() in ['staff', 'admin'];
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // A STAFF-authored participant update may only move operational fields.
    // Identity fields (name/studentId/year/badgeNumber/...) are frozen for
    // anyone but ADMIN — this is what stops a staff account from quietly
    // relabelling a participant or renumbering a badge.
    function onlyOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'arrived', 'checkInTime', 'checkInBy', 'called', 'skipped', 'updatedAt']);
    }

    // ---- participants (Firestore collection name: "guests") -------------
    match /guests/{id} {
      // PUBLIC: exact-id lookup only. There is no `list` grant for PUBLIC,
      // so the roster can never be enumerated — only looked up one at a
      // time, by someone who already knows the student ID.
      allow get: if true;

      // STAFF: needs to search/browse to run the check-in station and the
      // badge/MC queues.
      allow list: if isStaff();

      // Only ADMIN creates participants (manual add + Excel import both
      // route through the same service function).
      allow create: if isAdmin();

      // STAFF may flip operational state (check-in, handover, call, skip)
      // but nothing else. ADMIN may edit anything.
      allow update: if isAdmin() || (isStaff() && onlyOperationalFieldsChanged());

      allow delete: if isAdmin();
    }

    // ---- staff role registry --------------------------------------------
    match /staffUsers/{uid} {
      // Every signed-in user may read their OWN role doc (needed to know
      // what UI to show) — nothing else.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow get, list: if isAdmin();

      allow create, delete: if isAdmin();

      // An admin can change any OTHER staff member's role, but never their
      // own — this specifically blocks an admin from silently changing or
      // laundering their own privilege level.
      allow update: if isAdmin() && request.auth.uid != uid;
    }

    // ---- append-only check-in / handover history -------------------------
    match /checkInEvents/{id} {
      allow create: if isStaff();
      allow read: if isStaff();
      allow update, delete: if false; // immutable, even for ADMIN
    }

    // ---- append-only admin action log ------------------------------------
    match /auditLogs/{id} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false; // immutable, even for ADMIN
    }

    // ---- badge number sequence --------------------------------------------
    // A single counters/badgeSequence document. Incremented transactionally
    // in the same write as participant creation, so badge numbers are
    // assigned once, monotonically, without ever reading the full
    // collection to compute "the current max".
    //
    // `create` is allowed (not just `update`) because the first participant
    // ever added on a brand-new project — one with nothing to migrate — is
    // what creates this document for the first time; the migration script
    // (scripts/migrate-badge-numbers.mjs) only pre-seeds it when there was
    // existing data to carry a starting number over from.
    match /counters/{id} {
      allow get: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- pre-destructive-operation backups --------------------------------
    match /backups/{snapshotId} {
      allow read, write: if isAdmin();
      match /guests/{id} {
        allow read, write: if isAdmin();
      }
    }

    // ---- current stage state (LED display) ---------------------------------
    // Singleton doc holding who is currently called to stage, so the public
    // stage display never needs to read the roster — just this one doc.
    match /stageState/{id} {
      allow get: if true; // public display reads this
      allow write: if isStaff();
    }
  }
}
